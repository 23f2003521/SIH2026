# Excluded Legacy & Experimental Files (as requested)
# Root-anchored with a leading slash. Without it, a bare `app*.py` pattern
# matches at ANY depth and silently excludes ui/app.py -- the app entrypoint.
/app.py
/app1.py
/app*.py
old_PCA_new*.ipynb
old_PCA*.ipynb
ais-anomaly-detection.ipynb

# OS / Temporary Files
.DS_Store
*.log

# The SAR checkpoint is 105 MB -- over GitHub's 100 MB blob limit. It lives on
# the Hugging Face Hub and is fetched at runtime via POSEATSEA_WEIGHTS_REPO.
# The other three artefacts are small (804 KB total) and ARE committed.
models/best_sar_model.pth

# The curated SAR scene library IS part of the app: five real Sentinel-1 scenes
# plus the masks the shipped checkpoint produced for them. The blanket *.jpg /
# *.png rules above are for datasets, not these.
!assets/sar_samples/scenes/*.jpg
!assets/sar_samples/scenes/*.png
assets/sar_samples/raw/

# The real Mauritius AOI AIS extract (July 2020) is the app's primary data
# source, not a bulk dataset. The blanket *.csv rule above is for the latter.
!assets/ais/*.csv

# Coastal Vulnerability production layer & ecological models (required for deployed app)
!assets/coastal_vulnerability/coastal_exposure.geojson
!assets/coastal_vulnerability/natural_habitats.csv
!assets/coastal_vulnerability/invest_workspace/coastal_exposure_mauritius.csv
!assets/coastal_vulnerability/invest_workspace/intermediate/habitats/habitat_protection_mauritius.csv
!assets/habitats/*.gpkg
!assets/habitats/*.geojson

# Bulk raw datasets, heavy rasters, and intermediate caches (not stored in git)
assets/*.zip
assets/dem_glo30/
assets/gebco/
assets/derived/
assets/environment_cache/
assets/significant_height_of_combined_wind_waves_swell/
assets/coastal_vulnerability/invest_workspace/intermediate/relief/
assets/coastal_vulnerability/invest_workspace/intermediate/shore_points/
assets/coastal_vulnerability/invest_workspace/intermediate/surge/
assets/coastal_vulnerability/invest_workspace/intermediate/wind_wave/
assets/coastal_vulnerability/invest_workspace/taskgraph_cache/

